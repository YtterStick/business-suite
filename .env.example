# PostgreSQL connection string (Neon pooled URL for runtime queries)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_suite?schema=public"

# Direct/unpooled PostgreSQL connection string (used by Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/business_suite?schema=public"

# Shared secret required by /api/cron/cleanup and /api/health?db=1 ("Authorization: Bearer <secret>")
CRON_SECRET="replace-with-a-long-random-string"

# Password for the demo owner created by `npm run db:seed` (owner@acme.test)
SEED_OWNER_PASSWORD="ChangeMe-123!"

# Public app origin (used for Google OAuth callback URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 credentials for "Continue with Google"
# Authorized redirect URI in Google Cloud Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 direct upload & zero-egress edge file delivery (optional in local dev)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="tactiq-files"
R2_PUBLIC_BASE_URL="https://files.yourdomain.com"
